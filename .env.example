# Токен бота от @BotFather
BOT_TOKEN=

# API-ключ GLM (Z.ai) в формате {id}.{secret}
GLM_API_KEY=

# ID чатов, которым разрешён доступ (через запятую). Узнать свой: @userinfobot
ALLOWED_CHAT_IDS=123456789

# Модель GLM по умолчанию
GLM_MODEL=glm-4.6

# Base URL GLM API (международный Z.ai). Для open.bigmodel.cn поменяй хост.
GLM_BASE_URL=https://api.z.ai/api/paas/v4
