# Токен бота от @BotFather
BOT_TOKEN=

# API-ключ GLM (Z.ai) в формате {id}.{secret}
GLM_API_KEY=

# ID чатов, которым разрешён доступ (через запятую). Узнать свой: @userinfobot
ALLOWED_CHAT_IDS=123456789

# Модель GLM по умолчанию (GLM Coding Plan использует glm-5.2)
GLM_MODEL=glm-5.2

# Модель для web-режима (/web on): glm-4.6 — подтверждённый function calling.
WEB_MODEL=glm-4.6

# Ключ Яндекс.Расписаний (https://yandex.ru/dev/rasp) — для реальных расписаний
# поездов. Необязательно: без него бот честно скажет, что точного расписания нет.
YANDEX_RASP_KEY=

# Base URL GLM API (GLM Coding Plan). Для обычного плана: https://api.z.ai/api/paas/v4
GLM_BASE_URL=https://api.z.ai/api/coding/paas/v4
