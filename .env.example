# Токен бота от @BotFather
BOT_TOKEN=

# API-ключ GLM (Z.ai) в формате {id}.{secret}
GLM_API_KEY=

# ID чатов, которым разрешён доступ (через запятую). Узнать свой: @userinfobot
ALLOWED_CHAT_IDS=123456789

# Модель GLM по умолчанию (бесплатная, обычный план Z.ai)
GLM_MODEL=glm-4.5-flash

# Модель для web-режима (/web on) — поддерживает function calling
WEB_MODEL=glm-4.5-flash

# Base URL GLM API (обычный план). Для Coding Plan: https://api.z.ai/api/coding/paas/v4
GLM_BASE_URL=https://api.z.ai/api/paas/v4

# Бэкенд веб-поиска в ddgs (стабильные: yandex, brave, yahoo). По умолчанию yandex.
WEB_BACKEND=yandex

# Ключ Яндекс.Расписаний (https://yandex.ru/dev/rasp) — для реальных расписаний
# поездов. Необязательно: без него бот честно скажет, что точного расписания нет.
YANDEX_RASP_KEY=your_yandex_api_key_here
